/**
 * ДУП — создание Google Form из откорректированного опросника.
 *
 * Как запустить:
 * 1. Откройте https://script.google.com → Новый проект
 * 2. Вставьте этот код, сохраните
 * 3. Выберите функцию createDUPSurvey → Выполнить
 * 4. Разрешите доступ к Google Forms (при первом запуске)
 * 5. Ссылка на форму появится в журнале выполнения (View → Logs)
 */

function createDUPSurvey() {
  var form = FormApp.create("ДУП — опрос директоров филиалов");
  form.setDescription("Диагностика процессов Департамента управления проектами (ДУП), ТОО «Көркем Телеком». Цель — выявить боли во взаимодействии филиал ↔ ДУП ↔ центральный офис. Время заполнения: 20–30 минут.");
  form.setCollectEmail(true);
  form.setLimitOneResponsePerUser(false);
  form.setShuffleQuestions(false);

  form.addPageBreakItem().setTitle("Блок A. Общая информация о филиале");

  form.addTextItem().setTitle("A1. Ваш регион / филиал").setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle("A2. Сколько сотрудников в проектной/операционной команде филиала?")
    .setChoiceValues(["до 5", "6–15", "16–30", "более 30"])
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle("A3. Как часто вы взаимодействуете с куратором/менеджером проекта со стороны ДУП?")
    .setChoiceValues(["Ежедневно", "Несколько раз в неделю", "Раз в неделю", "Реже раза в неделю", "По мере необходимости"])
    .setRequired(true);

  form.addPageBreakItem().setTitle("Блок B. Реализация нового проекта");

  form.addScaleItem()
    .setTitle("B1. Насколько понятен вам процесс запуска нового проекта в филиале (от получения поручения до сдачи объекта)?")
    .setBounds(1, 5)
    .setLabels("1 — совсем непонятен", "5 — полностью понятен")
    .setRequired(true);

  form.addScaleItem()
    .setTitle("B2. Достаточно ли полным приходит пакет документов при старте проекта (договор, ФЭМ, ТЗ, адресная программа и т.д.)?")
    .setBounds(1, 5)
    .setLabels("1 — почти всегда неполный", "5 — почти всегда полный")
    .setRequired(true);

  form.addCheckboxItem()
    .setTitle("B3. Какие документы чаще всего отсутствуют или приходят с задержкой? (можно несколько)")
    .setChoices(["Адресная программа", "Финансово-экономическая модель (ФЭМ)", "Техническое задание / тех.карты", "Утверждённый бюджет", "Договор с госпартнёром", "Приказ на реализацию", "Ничего критичного не отсутствует", "Другое"])
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle("B4. Сколько в среднем занимает подготовка проектной документации филиалом (устав, план, приказ)?")
    .setChoiceValues(["до 1 недели", "1–2 недели", "2–4 недели", "более месяца", "Сроки непредсказуемы"])
    .setRequired(true);

  form.addScaleItem()
    .setTitle("B5. Насколько сложно согласовать бюджет проекта с Финблоком через ДУП?")
    .setBounds(1, 5)
    .setLabels("1 — очень сложно", "5 — проходит быстро")
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle("B6. Как часто закупочные процедуры (выше упрощённого порога) задерживают реализацию проекта?")
    .setChoiceValues(["Почти никогда", "Иногда (менее 25% проектов)", "Часто (25–50% проектов)", "Очень часто (более 50% проектов)", "Не могу оценить"])
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle("B7. Оцените среднюю длительность закупочной процедуры выше упрощённого порога (от заявки до договора)")
    .setChoiceValues(["до 2 недель", "2–4 недели", "1–2 месяца", "более 2 месяцев", "Сильно варьируется"])
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle("B8. Проводятся ли регулярные статус-встречи по проектам реализации?")
    .setChoiceValues(["Да, еженедельно", "Да, раз в две недели", "Да, ежемесячно", "Нерегулярно", "Практически не проводятся"])
    .setRequired(true);

  form.addParagraphTextItem().setTitle("B9. Опишите 1–2 типичных блокера на этапе реализации в вашем регионе").setRequired(true);

  form.addPageBreakItem().setTitle("Блок C. Постпроектное сопровождение");

  form.addScaleItem()
    .setTitle("C1. Насколько понятен процесс сопровождения действующих проектов после ввода в эксплуатацию?")
    .setBounds(1, 5)
    .setLabels("1 — совсем непонятен", "5 — полностью понятен")
    .setRequired(true);

  form.addCheckboxItem()
    .setTitle("C2. Какие задачи сопровождения выполняет филиал самостоятельно без участия ДУП? (можно несколько)")
    .setChoices(["Контроль работоспособности оборудования", "Сопровождение канала связи", "Взаимодействие с госпартнёром на местах", "Организация поверки (координация с лабораторией)", "Перенос оборудования по запросу госпартнёра", "Подготовка ежемесячной отчётности госпартнёру", "Инициация продления / модернизации контракта", "Другое"])
    .setRequired(true);

  form.addScaleItem()
    .setTitle("C3. Насколько своевременно ДУП реагирует на операционные проблемы (инциденты, простои, претензии госпартнёра)?")
    .setBounds(1, 5)
    .setLabels("1 — очень медленно", "5 — оперативно")
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle("C4. Сталкивались ли вы с ситуацией, когда продукт/оборудование передали в эксплуатацию до полной готовности (пилот не завершён)?")
    .setChoiceValues(["Да, неоднократно", "Да, единичные случаи", "Нет", "Затрудняюсь ответить"])
    .setRequired(true);

  form.addCheckboxItem()
    .setTitle("C5. Если да — к чему это приводило? (можно несколько)")
    .setChoices(["Претензии госпартнёра", "Штрафы / санкции", "Дополнительные работы и перерасход бюджета", "Репутационные потери", "Не приводило к серьёзным последствиям", "Не применимо"])
    .setRequired(false);

  form.addScaleItem()
    .setTitle("C6. Насколько налажен процесс передачи информации о дефектах компонентов (от монтажников/эксплуатации к закупкам/ТЗ)?")
    .setBounds(1, 5)
    .setLabels("1 — не налажен", "5 — отлично налажен")
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle("C7. Как часто филиал инициирует продление или модернизацию контракта с госпартнёром?")
    .setChoiceValues(["Регулярно, по регламенту", "Иногда, когда срок подходит", "Редко — ДУП/ДРБ инициируют сами", "Процесс не формализован"])
    .setRequired(true);

  form.addParagraphTextItem().setTitle("C8. Опишите главную боль в операционном сопровождении в вашем филиале").setRequired(true);

  form.addPageBreakItem().setTitle("Блок D. Финансы и платежи");

  form.addMultipleChoiceItem()
    .setTitle("D1. Кто в филиале формирует реестр платежей?")
    .setChoiceValues(["Менеджер проектов / проектный офис филиала", "Бухгалтерия филиала", "Директор филиала", "Несколько ролей совместно", "Другое"])
    .setRequired(true);

  form.addScaleItem()
    .setTitle("D2. Насколько понятен процесс приоритизации платежей (филиал → ДУП → Финблок)?")
    .setBounds(1, 5)
    .setLabels("1 — совсем непонятен", "5 — полностью понятен")
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle("D3. Как часто платежи по вашим заявкам задерживаются дольше критичного срока?")
    .setChoiceValues(["Почти никогда", "Иногда (до 25% заявок)", "Часто (25–50%)", "Очень часто (более 50%)"])
    .setRequired(true);

  form.addCheckboxItem()
    .setTitle("D4. Какова типичная причина задержки оплат? (можно несколько)")
    .setChoices(["Неполный пакет документов от филиала", "Долгое согласование в ДУП", "Очередь / приоритизация в Финблоке", "Проблемы с закупочной процедурой", "Нехватка бюджета по проекту", "Не знаю причину", "Другое"])
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle("D5. Участвует ли филиал в прогнозе поступлений доходов от госпартнёра?")
    .setChoiceValues(["Да, регулярно по шаблону", "Да, но нерегулярно / по запросу в чате", "Нет, это делает только ДУП", "Процесс не налажен"])
    .setRequired(true);

  form.addScaleItem()
    .setTitle("D6. Насколько удобен текущий формат обмена данными по прогнозу поступлений/расходов с Финблоком?")
    .setBounds(1, 5)
    .setLabels("1 — совсем неудобен", "5 — очень удобен")
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle("D7. Сталкивались ли с ситуацией нехватки бюджета проекта (перерасход по ФЭМ)?")
    .setChoiceValues(["Да, неоднократно", "Да, единичные случаи", "Нет", "Не знаю"])
    .setRequired(true);

  form.addParagraphTextItem().setTitle("D8. Если да — как решался вопрос?").setRequired(false);

  form.addPageBreakItem().setTitle("Блок E. Взаимодействие с ДУП");

  form.addScaleItem()
    .setTitle("E1. Насколько чётко разграничены зоны ответственности между филиалом и ДУП?")
    .setBounds(1, 5)
    .setLabels("1 — совсем неясно", "5 — чётко разграничено")
    .setRequired(true);

  form.addScaleItem()
    .setTitle("E2. Понимаете ли вы, к кому в ДУП обращаться по разным типам вопросов (реализация / сопровождение / финансы / методология)?")
    .setBounds(1, 5)
    .setLabels("1 — плохо", "5 — хорошо")
    .setRequired(true);

  form.addScaleItem()
    .setTitle("E3. Как вы оцениваете качество коммуникации с куратором ДУП?")
    .setBounds(1, 5)
    .setLabels("1 — очень плохо", "5 — отлично")
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle("E4. Бывали ли случаи эскалации проблем в обход ДУП напрямую к топ-менеджменту или внешним партнёрам?")
    .setChoiceValues(["Да, со стороны филиала", "Да, со стороны внешних партнёров/госорганов", "Да, с обеих сторон", "Нет"])
    .setRequired(true);

  form.addPageBreakItem().setTitle("Блок F. Взаимодействие с другими подразделениями ЦО");

  form.addGridItem()
    .setTitle("F1. Оцените взаимодействие филиала с подразделениями (1 — очень плохо, 5 — отлично)")
    .setRows(["ДРБ", "Финблок", "Юр блок", "Закупки (ОЛЖА)", "СТ (тех. блок)", "Зерек / Zerek Road tech", "HR", "Лаборатория (поверка)"])
    .setColumns(["1", "2", "3", "4", "5"])
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle("F2. С каким подразделением чаще всего возникают задержки и недопонимание?")
    .setChoiceValues(["ДРБ", "Финблок", "Юр блок", "Закупки", "СТ", "Зерек", "HR", "Нет системных проблем", "Другое"])
    .setRequired(true);

  form.addScaleItem()
    .setTitle("F3. Насколько своевременно ДРБ передаёт проекты с полным пакетом документов?")
    .setBounds(1, 5)
    .setLabels("1 — очень медленно", "5 — оперативно")
    .setRequired(true);

  form.addScaleItem()
    .setTitle("F4. Насколько оперативно Юр блок сопровождает договоры и открытие филиала?")
    .setBounds(1, 5)
    .setLabels("1 — плохо", "5 — хорошо")
    .setRequired(true);

  form.addParagraphTextItem().setTitle("F5. Опишите типичную проблему во взаимодействии с центральным офисом (кроме ДУП)").setRequired(true);

  form.addPageBreakItem().setTitle("Блок G. Инструменты и системы");

  form.addCheckboxItem()
    .setTitle("G1. Какие инструменты вы используете в ежедневной проектной работе? (можно несколько)")
    .setChoices(["SimBase / корпоративная платформа проектов", "Jira", "Confluence", "Excel / Google Таблицы", "1С", "Мессенджеры", "Бумажный документооборот", "Другое"])
    .setRequired(true);

  form.addScaleItem()
    .setTitle("G2. Насколько полноценно работает платформа портфеля проектов (документация, бюджет план/факт, риски, задачи)?")
    .setBounds(1, 5)
    .setLabels("1 — не работает", "5 — работает полноценно")
    .setRequired(true);

  form.addCheckboxItem()
    .setTitle("G3. Чего не хватает в текущих IT-инструментах для вашей работы?")
    .setChoices(["Единая карточка проекта с обязательными полями", "Автоуведомления (срок контракта, просрочки, платежи)", "Интеграция закупок и 1С", "Мониторинг оборудования (Zabbix и т.д.)", "Шаблоны отчётов и реестров", "Мобильный доступ", "Ничего критичного", "Другое"])
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle("G4. Сколько времени в неделю уходит на ручной сбор данных и отчётность (вне системы)?")
    .setChoiceValues(["менее 2 часов", "2–5 часов", "5–10 часов", "более 10 часов"])
    .setRequired(true);

  form.addPageBreakItem().setTitle("Блок H. Итоговая оценка и предложения");

  form.addParagraphTextItem().setTitle("H1. Назовите ТОП-3 проблемы в процессах, которые сильнее всего мешают работе филиала").setRequired(true);

  form.addParagraphTextItem().setTitle("H2. Назовите ТОП-3 процесса, которые нужно автоматизировать в первую очередь").setRequired(true);

  form.addParagraphTextItem().setTitle("H3. Если бы вы могли изменить одну вещь в работе ДУП и филиалов — что бы это было?").setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle("H4. Готовы ли вы участвовать в 30–45-минутном углублённом интервью для детализации ответов?")
    .setChoiceValues(["Да", "Нет", "Возможно, по согласованию"])
    .setRequired(true);

  form.addTextItem().setTitle("H5. Контакт для связи (email / телефон) — если готовы к интервью").setRequired(false);

  Logger.log('Форма создана: ' + form.getPublishedUrl());
  Logger.log('Редактирование: ' + form.getEditUrl());
}